rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'master_admin' ||
        request.auth.token.role == 'MASTER_ADMIN' ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isDistributor(distributorUid) {
      return isAuthenticated() && (
        request.auth.uid == distributorUid ||
        request.auth.token.role == 'distributor_admin' ||
        request.auth.token.role == 'DISTRIBUTOR_ADMIN'
      );
    }

    function isDoctor(doctorUid) {
      return isAuthenticated() && request.auth.uid == doctorUid;
    }

    match /adminUsers/{adminUid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == adminUid;
      allow update, delete: if isMasterAdmin();
    }

    match /distributors/{distributorUid} {
      allow read: if isMasterAdmin() || isDistributor(distributorUid);
      allow create: if isAuthenticated() && (request.auth.uid == distributorUid || isMasterAdmin());
      allow update: if isMasterAdmin() || (
        isDistributor(distributorUid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'commissionRate', 'uid'])
      );
      allow delete: if isMasterAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /features/{featureId} {
      allow read: if isAuthenticated();
      allow write: if isMasterAdmin();
    }

    match /customerRequests/{requestId} {
      allow read: if isMasterAdmin() || (
        isAuthenticated() && resource.data.distributorUid == request.auth.uid
      );
      allow create: if isMasterAdmin() || (
        isAuthenticated() &&
        request.resource.data.distributorUid == request.auth.uid &&
        request.resource.data.status in ['PENDING_REVIEW', 'PENDING'] &&
        (!('provisioningStatus' in request.resource.data) || request.resource.data.provisioningStatus == 'NOT_STARTED')
      );
      allow update: if isMasterAdmin() || (
        isAuthenticated() &&
        resource.data.distributorUid == request.auth.uid &&
        resource.data.status in ['PENDING_REVIEW', 'PENDING', 'NEEDS_INFORMATION'] &&
        request.resource.data.status == 'CANCELLED' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'distributorUid', 'planId', 'doctorName', 'email', 'reviewedBy', 'reviewedAt', 'provisionedDoctorUid', 'provisioningStatus'
        ])
      );
      allow delete: if isMasterAdmin();
    }

    match /customers/{customerUid} {
      allow read: if isMasterAdmin() || 
        (isAuthenticated() && resource.data.distributorUid == request.auth.uid) ||
        isDoctor(customerUid);
      allow write: if isMasterAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isMasterAdmin() ||
        (isAuthenticated() && resource.data.distributorUid == request.auth.uid) ||
        (isAuthenticated() && resource.data.doctorUid == request.auth.uid);
      allow write: if isMasterAdmin();
    }

    match /sales/{saleId} {
      allow read: if isMasterAdmin() ||
        (isAuthenticated() && resource.data.distributorUid == request.auth.uid);
      allow write: if isMasterAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isMasterAdmin() || (
        isAuthenticated() && resource.data.recipientUid == request.auth.uid
      ) || (
        isMasterAdmin() && resource.data.recipientRole in ['master_admin', 'all_admins']
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        (isMasterAdmin() && resource.data.recipientRole in ['master_admin', 'all_admins'])
      );
      allow delete: if isMasterAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isMasterAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /doctors/{doctorUid} {
      allow read: if isMasterAdmin() || isDoctor(doctorUid) || (
        isAuthenticated() && resource.data.uid == request.auth.uid
      );
      allow write: if isMasterAdmin() || isDoctor(doctorUid);
    }

    match /doctor_profile/{profileId} {
      allow read, write: if true;
    }

    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if isMasterAdmin() || (isAuthenticated() && request.resource.data.doctorId == request.auth.uid) || (
        isAuthenticated() && (
          request.auth.token.role in ['distributor_admin', 'DISTRIBUTOR_ADMIN'] ||
          exists(/databases/$(database)/documents/distributors/$(request.auth.uid))
        )
      );
      allow update, delete: if isMasterAdmin() || resource.data.doctorId == null || (
        isAuthenticated() && resource.data.doctorId == request.auth.uid
      );
    }

    match /predefined_medicines/{medicineId} {
      allow read, write: if true;
    }

    match /medicines/{medicineId} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read: if true;
      allow create: if request.resource.data.clinicId != null;
      allow update, delete: if true;
    }

    match /visits/{visitId} {
      allow read: if true;
      allow create: if request.resource.data.patientId != null && request.resource.data.clinicId != null;
      allow update, delete: if true;
    }
  }
}
